{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/lint-config/packages/oxlint-config/wxt.json",
    "./node_modules/lint-config/packages/oxlint-plugin-naming/preset.json"
  ],
  "rules": {
    "naming/convention": [
      "error",
      {
        "presets": ["webextension-manifest", "webextension-messages", "hook-names"],
        "allowedNames": [
          {
            "reason": "The HTTP header is spelled this way",
            "names": ["Authorization"]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    ".claude/**",
    "node_modules/**",
    ".output/**",
    ".wxt/**",
    "build/**",
    "user-profiles/**",
    "keys/**"
  ],
  "overrides": [
    {
      "files": ["scripts/headless-chrome.mjs", "src/entrypoints/auto-like-in-subscription.content.ts"],
      "rules": {
        "house/positional-parameters": "off"
      }
    }
  ]
}
