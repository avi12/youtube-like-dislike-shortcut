{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": ["./node_modules/fallow-config-avi12/fallow.json"],
  "entry": [
    "wxt.config.ts",
    "web-ext.config.ts",
    "src/entrypoints/popup/main.ts",
    "src/entrypoints/ytr-trigger.content.ts",
    "src/entrypoints/ytr-embed.content.ts",
    "src/entrypoints/ytr-rate-api.content.ts",
    "src/entrypoints/auto-like-percentage.content/index.ts",
    "src/entrypoints/auto-like-in-subscription.content.ts",
    "src/entrypoints/auto-like-percentage-music.content/index.ts"
  ],
  "ignorePatterns": [".claude/**", "tests/**", "scripts/**"],
  "ignoreDependencies": [
    "#imports",
    "@sveltejs/vite-plugin-svelte",
    "@wxt-dev/module-svelte",
    "avi12-lint",
    "chokidar",
    "crx3",
    "eslint-config-avi12",
    "fallow-config-avi12",
    "oxfmt-config-avi12",
    "oxlint-config-avi12",
    "oxlint-plugin-naming",
    "postcss-html",
    "stylelint-config-avi12",
    "web-ext-run"
  ],
  "rules": { "unused-enum-members": "off", "unresolved-imports": "off" }
}
