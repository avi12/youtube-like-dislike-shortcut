{
  "name": "youtube-like-dislike-shortcut",
  "version": "2.7.0",
  "description": "Like videos with Shift+Plus or Numpad Plus, dislike with Shift+Minus or Numpad Minus.",
  "repository": "https://github.com/avi12/youtube-like-dislike-shortcut",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Avi <avi6106@gmail.com>",
  "homepage": "https://avi12.com/youtube-like-dislike-shortcut",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:with-profile": "tsx scripts/dev-server.ts --browser chrome --with-profile",
    "dev:rtl": "pnpx cross-env LANG=he tsx scripts/dev-server.ts",
    "dev:edge": "tsx scripts/dev-server.ts --browser edge",
    "dev:edge:with-profile": "tsx scripts/dev-server.ts --browser edge --with-profile",
    "dev:firefox": "tsx scripts/dev-server.ts --browser firefox",
    "dev:firefox:with-profile": "tsx scripts/dev-server.ts --browser firefox --with-profile",
    "dev:wxt": "wxt",
    "build": "wxt build --mode prod",
    "build:opera": "pnpm build -b opera",
    "build:firefox": "pnpm build -b firefox --mv3",
    "package": "wxt zip --mode prod",
    "package:opera": "pnpm package -b opera",
    "package:firefox": "pnpm package -b firefox --mv3",
    "crx": "pnpm package && tsx scripts/pack-crx.ts",
    "package:all": "concurrently \"pnpm package\" \"pnpm package:opera\" \"pnpm package:firefox\" --names Chrome,Opera,Firefox",
    "svelte:check": "pnpx svelte-check",
    "typecheck": "tsrs --noEmit --fast",
    "lint:fix": "avi12-lint --fix",
    "postinstall": "wxt prepare",
    "lint": "avi12-lint"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "avi12-lint": "github:avi12/lint-config#v0.4.7&path:/packages/avi12-lint",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.6",
    "crx3": "2.0.0",
    "eslint": "^10.13.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/eslint-config",
    "eslint-plugin-svelte": "^3.23.1",
    "fallow": "^3.34.1",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/fallow-config",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/oxfmt-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.7&path:/packages/oxlint-plugin-naming",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.7&path:/packages/stylelint-config",
    "svelte-eslint-parser": "^1.9.0",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "web-ext-run": "^0.2.4",
    "wxt": "0.21.4"
  },
  "overrides": {
    "acorn": "8.16.0"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "svelte": "5.57.2"
  }
}
