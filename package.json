{
  "name": "youtube-like-dislike-shortcut",
  "version": "2.7.0",
  "description": "Like videos with Shift+Plus or Numpad Plus, dislike with Shift+Minus or Numpad Minus.",
  "homepage": "https://avi12.com/youtube-like-dislike-shortcut",
  "license": "GPL-3.0-or-later",
  "author": "Avi <avi6106@gmail.com>",
  "repository": "https://github.com/avi12/youtube-like-dislike-shortcut",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:with-profile": "tsx scripts/dev-server.ts --browser chrome --with-profile",
    "dev:rtl": "bunx cross-env LANG=he tsx scripts/dev-server.ts",
    "dev:edge": "tsx scripts/dev-server.ts --browser edge",
    "dev:edge:with-profile": "tsx scripts/dev-server.ts --browser edge --with-profile",
    "dev:firefox": "tsx scripts/dev-server.ts --browser firefox",
    "dev:firefox:with-profile": "tsx scripts/dev-server.ts --browser firefox --with-profile",
    "dev:wxt": "wxt",
    "build": "wxt build --mode prod",
    "build:opera": "bun run build -b opera",
    "build:firefox": "bun run build -b firefox --mv3",
    "package": "wxt zip --mode prod",
    "package:opera": "bun run package -b opera",
    "package:firefox": "bun run package -b firefox --mv3",
    "crx": "bun run package && tsx scripts/pack-crx.ts",
    "package:all": "concurrently \"bun run package\" \"bun run package:opera\" \"bun run package:firefox\" --names Chrome,Opera,Firefox",
    "svelte:check": "avi12-svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsrs --noEmit --fast",
    "lint:fix": "avi12-lint --fix",
    "postinstall": "wxt prepare",
    "lint": "avi12-lint"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "svelte": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.6",
    "crx3": "2.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fallow": "^3.34.1",
    "globals": "^17.13.0",
    "lint-config": "github:avi12/lint-config#v0.13.1",
    "oxfmt": "^0.78.0",
    "oxlint": "1.90.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.9.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "web-ext-run": "^0.2.4",
    "wxt": "0.21.4"
  },
  "overrides": {
    "acorn": "8.16.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "zod@4.6.7": "patches/zod.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "fallow",
    "spawn-sync"
  ]
}
